digraph IR {
  graph [fontname="Times New Roman",fontsize=10];
  node  [fontname="Courier New",fontsize=10];
  edge  [fontname="Times New Roman",fontsize=10];

  // scope 'array05'
  array05_cb [label="array05\r  0:     param  0 <integer> <- 11111111 <integer>\l  1:     call   WriteInt\l  2:     call   WriteLn\l  3:     &()    t <- A\l  4:     param  0 <integer> <- t\l  5:     call   Print\l  6:     param  0 <integer> <- 22222222 <integer>\l  7:     call   WriteInt\l  8:     call   WriteLn\l  9:     &()    t0 <- A\l 10:     param  0 <integer> <- t0\l 11:     call   Init\l",shape=box]
  // scope 'Set'
  Set_cb [label="Set\r  0:     param  1 <integer> <- 2 <integer>\l  1:     param  0 <integer> <- P\l  2:     call   t1 <- DIM\l  3:     mul    t2 <- v, t1\l  4:     add    t3 <- t2, v\l  5:     mul    t4 <- t3, 4 <integer>\l  6:     param  0 <integer> <- P\l  7:     call   t5 <- DOFS\l  8:     add    t6 <- t4, t5\l  9:     add    t7 <- P, t6\l 10:     assign @t7 <- 1 <integer>\l",shape=box]
  // scope 'Print'
  Print_cb [label="Print\r  0:     param  1 <integer> <- 1 <integer>\l  1:     param  0 <integer> <- A\l  2:     call   t1 <- DIM\l  3:     assign N <- t1\l  4:     param  1 <integer> <- 2 <integer>\l  5:     param  0 <integer> <- A\l  6:     call   t2 <- DIM\l  7:     assign M <- t2\l  8:     assign i <- 0 <integer>\l  9: 4_while_cond:\l 10:     if     i < N goto 5_while_body\l 11:     goto   3\l 12: 5_while_body:\l 13:     assign j <- 0 <integer>\l 14: 9_while_cond:\l 15:     if     j < M goto 10_while_body\l 16:     goto   8\l 17: 10_while_body:\l 18:     param  1 <integer> <- 2 <integer>\l 19:     param  0 <integer> <- A\l 20:     call   t3 <- DIM\l 21:     mul    t4 <- i, t3\l 22:     add    t5 <- t4, j\l 23:     mul    t6 <- t5, 4 <integer>\l 24:     param  0 <integer> <- A\l 25:     call   t7 <- DOFS\l 26:     add    t8 <- t6, t7\l 27:     add    t9 <- A, t8\l 28:     param  0 <integer> <- @t9\l 29:     call   WriteInt\l 30:     call   WriteLn\l 31:     add    t10 <- j, 1 <integer>\l 32:     assign j <- t10\l 33:     goto   9_while_cond\l 34: 8:\l 35:     add    t11 <- i, 1 <integer>\l 36:     assign i <- t11\l 37:     goto   4_while_cond\l 38: 3:\l",shape=box]
  // scope 'Init'
  Init_cb [label="Init\r  0:     param  1 <integer> <- 1 <integer>\l  1:     param  0 <integer> <- a\l  2:     call   t1 <- DIM\l  3:     assign N <- t1\l  4:     param  1 <integer> <- 2 <integer>\l  5:     param  0 <integer> <- a\l  6:     call   t2 <- DIM\l  7:     assign M <- t2\l  8:     assign c <- 0 <integer>\l  9:     assign i <- 0 <integer>\l 10: 5_while_cond:\l 11:     if     i < N goto 6_while_body\l 12:     goto   4\l 13: 6_while_body:\l 14:     assign j <- 0 <integer>\l 15: 10_while_cond:\l 16:     if     j < M goto 11_while_body\l 17:     goto   9\l 18: 11_while_body:\l 19:     param  1 <integer> <- 2 <integer>\l 20:     param  0 <integer> <- a\l 21:     call   t3 <- DIM\l 22:     mul    t4 <- i, t3\l 23:     add    t5 <- t4, j\l 24:     mul    t6 <- t5, 4 <integer>\l 25:     param  0 <integer> <- a\l 26:     call   t7 <- DOFS\l 27:     add    t8 <- t6, t7\l 28:     add    t9 <- a, t8\l 29:     assign @t9 <- c\l 30:     add    t10 <- c, 1 <integer>\l 31:     assign c <- t10\l 32:     add    t11 <- j, 1 <integer>\l 33:     assign j <- t11\l 34:     goto   10_while_cond\l 35: 9:\l 36:     add    t12 <- i, 1 <integer>\l 37:     assign i <- t12\l 38:     goto   5_while_cond\l 39: 4:\l 40:     param  0 <integer> <- a\l 41:     call   Print\l",shape=box]
}
