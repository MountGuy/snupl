  // scope 'print'
  print_cb [label="print\r  0:     assign i <- 0 <integer>\l  1: 2_while_cond:\l  2:     if     i < 3 <integer> goto 3_while_body\l  3:     goto   1\l  4: 3_while_body:\l  5:     assign j <- 0 <integer>\l  6: 7_while_cond:\l  7:     if     j < 3 <integer> goto 8_while_body\l  8:     goto   6\l  9: 8_while_body:\l 10:     &()    t20 <- A\l 11:     &()    t21 <- A\l 12:     param  1 <integer> <- 2 <integer>\l 13:     param  0 <integer> <- t21\l 14:     call   t22 <- DIM\l 15:     mul    t23 <- i, t22\l 16:     add    t24 <- t23, j\l 17:     mul    t25 <- t24, 4 <integer>\l 18:     &()    t26 <- A\l 19:     param  0 <integer> <- t26\l 20:     call   t27 <- DOFS\l 21:     add    t28 <- t25, t27\l 22:     add    t29 <- t20, t28\l 23:     param  0 <integer> <- @t29\l 24:     call   WriteInt\l 25:     add    t30 <- j, 1 <integer>\l 26:     assign j <- t30\l 27:     goto   7_while_cond\l 28: 6:\l 29:     add    t31 <- i, 1 <integer>\l 30:     assign i <- t31\l 31:     goto   2_while_cond\l 32: 1:\l 33:     call   WriteLn\l",shape=box]
