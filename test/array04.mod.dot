  array04_cb [label="array04\r  0:     param  0 <integer> <- 11111111 <integer>\l  1:     call   WriteInt\l  2:     call   WriteLn\l  3:     call   print\l  4:     &()    t <- A\l  5:     &()    t0 <- A\l  6:     param  1 <integer> <- 2 <integer>\l  7:     param  0 <integer> <- t0\l  8:     call   t1 <- DIM\l  9:     mul    t2 <- 0 <integer>, t1\l 10:     add    t3 <- t2, 0 <integer>\l 11:     mul    t4 <- t3, 4 <integer>\l 12:     &()    t5 <- A\l 13:     param  0 <integer> <- t5\l 14:     call   t6 <- DOFS\l 15:     add    t7 <- t4, t6\l 16:     add    t8 <- t, t7\l 17:     assign @t8 <- 2 <integer>\l 18:     &()    t9 <- A\l 19:     &()    t10 <- A\l 20:     param  1 <integer> <- 2 <integer>\l 21:     param  0 <integer> <- t10\l 22:     call   t11 <- DIM\l 23:     mul    t12 <- 0 <integer>, t11\l 24:     add    t13 <- t12, 0 <integer>\l 25:     mul    t14 <- t13, 4 <integer>\l 26:     &()    t15 <- A\l 27:     param  0 <integer> <- t15\l 28:     call   t16 <- DOFS\l 29:     add    t17 <- t14, t16\l 30:     add    t18 <- t9, t17\l 31:     assign i <- @t18\l 32:     &()    t19 <- A\l 33:     param  1 <integer> <- i\l 34:     param  0 <integer> <- t19\l 35:     call   Set\l 36:     param  0 <integer> <- 22222222 <integer>\l 37:     call   WriteInt\l 38:     call   WriteLn\l 39:     call   print\l",shape=box]
