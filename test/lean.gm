// Lean 4 어휘 문법 (UTF-8 테스트용)
//
// 바이트 폭 커버리지
//   1바이트  ASCII            a-z 0-9 := => ->
//   2바이트  그리스           α β γ Σ Π λ
//   3바이트  화살표/수학/첨자  → ↦ ∀ ∃ ≤ ⊆ × ⟨ ⟩ ℕ ℝ ₁ ₂
//   4바이트  BMP 밖            𝕜 𝕫  (surrogate pair 영역)
//
// 표기 규약
//   "x"         리터럴. 멀티바이트 문자도 직접 쓸 수 있다 ("α", "→") -- 파일을
//               바이트로 읽으므로 UTF-8 인코딩이 그대로 바이트열이 된다.
//   "a" ~ "z"   범위. 양 끝점의 UTF-8 바이트열 사이를 뜻한다.
//   0xHH..      *바이트열* 을 hex 로 적은 것. 코드포인트 번호가 아니다.
//               예) 0xf48fbfbf = U+10FFFF 의 UTF-8 (F4 8F BF BF)
//                   0xe28692   = U+2192 "→" 의 UTF-8 (E2 86 92)
//               hex 는 직접 쓸 수 없는 문자에만 쓴다 (제어문자, 따옴표, 역슬래시).

file = { item } ;
item = _ident | _number | _string | _char | keyword | operator ;

//---------------------------------------------------------------- 어휘 요소

__ascii_lower = "a" ~ "z" ;
__ascii_upper = "A" ~ "Z" ;
__digit       = "0" ~ "9" ;

__greek_lower = "α" ~ "ω" ;        // UTF-8: CE B1 ~ CF 89
__greek_upper = "Α" ~ "Ρ" | "Σ" ~ "Ω" ;   // CE 91~CE A1, CE A3~CE A9 (U+03A2 는 미할당)
__letterlike  = "℀" ~ "⅏" ;        // E2 84 80 ~ E2 85 8F : ℕ ℤ ℚ ℝ ℂ
__subscript   = "₀" ~ "₉" ;        // E2 82 80 ~ E2 82 89
__dstruck     = "𝕜" ~ "𝕫" ;        // F0 9D 95 9C ~ F0 9D 95 AB : 4바이트

__id_begin = __ascii_lower | __ascii_upper | "_"
           | __greek_lower | __greek_upper | __letterlike | __dstruck ;
__id_rest  = __id_begin | __digit | __subscript | "'" | "!" | "?" ;

_ident  = __id_begin , { __id_rest } ;
_number = __digit , { __digit } ;

//---------------------------------------------------------------- 문자열/문자

__escape   = 0x5c , ( "n" | "t" | "r" | "0" | 0x22 | 0x27 | 0x5c | "x" , __hexdigit , __hexdigit ) ;
__hexdigit = __digit | "a" ~ "f" | "A" ~ "F" ;

// 문자열 본문: 0x22(") 와 0x5c(\) 를 뺀 유니코드 전체.
// 밴드를 열거하면 안 된다 -- Lean 문자열엔 어떤 문자든 올 수 있다.
__strchar = 0x20 ~ 0x21 | 0x23 ~ 0x5b | 0x5d ~ 0xf48fbfbf | __escape ;

// 문자 상수 본문: 0x27(') 와 0x5c(\) 를 뺀 유니코드 전체
__charchar = 0x20 ~ 0x26 | 0x28 ~ 0x5b | 0x5d ~ 0xf48fbfbf | __escape ;

_string = 0x22 , { __strchar } , 0x22 ;
_char   = 0x27 , __charchar , 0x27 ;

//---------------------------------------------------------------- 키워드

keyword = "def" | "theorem" | "lemma" | "example" | "abbrev"
        | "structure" | "inductive" | "instance" | "class" | "where"
        | "namespace" | "section" | "end" | "open" | "variable" | "universe"
        | "fun" | "let" | "have" | "show" | "from" | "by" | "calc"
        | "match" | "with" | "do" | "if" | "then" | "else" | "return"
        | "exact" | "intro" | "apply" | "simp" | "rfl" | "sorry"
        | "Type" | "Prop" | "List" | "Set" | "Nat" ;

//---------------------------------------------------------------- 연산자
//
// maximal munch 스트레스가 걸리는 조합:
//   ":" vs ":=" vs "::"      "-" vs "->" vs "--"
//   "=" vs "=>" vs "=="      "<" vs "<-" vs "<="

operator = ":=" | "=>" | "->" | "<-" | "<->" | "::" | ".." | "==" | "!="
         | "<=" | ">=" | "&&" | "||" | "|>" | "<|"
         | "(" | ")" | "[" | "]" | "{" | "}"
         | ":" | ";" | "," | "." | "|" | "@" | "$" | "_"
         | "+" | "-" | "*" | "/" | "%" | "^" | "<" | ">" | "=" | "!" | "?" | "~"
         | "→" | "←" | "↔" | "⇒" | "↦" | "⊢" | "≡"
         | "∀" | "∃" | "λ" | "Σ" | "Π"
         | "∧" | "∨" | "¬" | "≠" | "≤" | "≥"
         | "∈" | "∉" | "⊆" | "⊂" | "∩" | "∪" | "∅"
         | "×" | "∘" | "·" | "∑" | "∏" | "√"
         | "⟨" | "⟩" | "⟦" | "⟧" ;

//---------------------------------------------------------------- 주석
//
// Lean 4 의 줄 주석은 "--" 다. 블록 주석 "/- -/" 은 *중첩이 허용되는데*
// 중첩은 정규 언어가 아니라서 NFA 로 표현할 수 없다 (별도 처리 필요).
// 중첩 없는 블록 주석은 정규 언어이고, 아래 _blockcomment 가 그걸 받는다.
// 중첩된 주석은 렉싱에 실패하지는 않고 첫 "-/" 에서 끊긴다.

// 개행(0x0a) 과 NUL 을 뺀 유니코드 전체.
// 상한은 반드시 0xf48fbfbf (U+10FFFF) 여야 한다. 0xff 로 끝내면 안 되는데,
// 0xff 는 UTF-8 선두 바이트로 올 수 없는 바이트라 범위가 성립하지 않는다.
// "X 빼고 전부" 꼴의 규칙은 전부 이 상한으로 끝나야 한다.
__notnewline = 0x01 ~ 0x09 | 0x0b ~ 0xf48fbfbf ;
_comment = "--" , { __notnewline } , 0x0a ;

// 블록 주석 본문은 "-/" 를 포함하지 않는 바이트열이다. 부정 연산자가 없으니
// 직접 전개한다 -- "-/" 를 피하는 언어의 정규식은
//
//     ( [^-] | -+ [^-/] )* -*
//
// 이다 (상태 2개 DFA: '-' 를 본 적 없음 / 방금 '-' 를 봤음).
// 본문이 "-/" 를 애초에 포함할 수 없으므로 maximal munch 로도 안전하다.
// 본문을 { __any } 로 두면 파일 안의 *마지막* "-/" 까지 한 덩어리로 먹는다.
__bc_nodash  = 0x01 ~ 0x2c | 0x2e ~ 0xf48fbfbf ;            // '-'(0x2d) 제외
__bc_nodashslash = 0x01 ~ 0x2c | 0x2e | 0x30 ~ 0xf48fbfbf ; // '-' '/'(0x2f) 제외

_blockcomment = "/-" , { __bc_nodash | "-" , { "-" } , __bc_nodashslash } ,
                { "-" } , "-/" ;
